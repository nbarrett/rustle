{
  "name": "rustle",
  "private": true,
  "version": "0.1.10",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "start": "tauri dev",
    "build": "tauri build",
    "typecheck": "tsc --noEmit",
    "web:wasm": "wasm-pack build web/wasm --target web --out-dir pkg --release",
    "web:dev": "pnpm run web:wasm && vite --config vite.web.config.ts",
    "web:build": "pnpm run web:wasm && vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@huggingface/transformers": "^3.7.6"
  }
}
